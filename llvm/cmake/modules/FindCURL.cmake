# Try to find the curl library.
#
# If LLVM_CURL_SOURCE_DIR is set, curl is compiled as a static target inside
# the LLVM build graph instead of being found from the host system. Set
# LLVM_BORINGSSL_SOURCE_DIR with it to build curl against vendored BoringSSL.

if(LLVM_CURL_SOURCE_DIR)
  get_filename_component(LLVM_CURL_SOURCE_DIR "${LLVM_CURL_SOURCE_DIR}" ABSOLUTE)
  if(NOT EXISTS "${LLVM_CURL_SOURCE_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "LLVM_CURL_SOURCE_DIR does not contain curl sources: ${LLVM_CURL_SOURCE_DIR}")
  endif()

  set(BUILD_CURL_EXE OFF CACHE BOOL "" FORCE)
  set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(BUILD_LIBCURL_DOCS OFF CACHE BOOL "" FORCE)
  set(BUILD_MISC_DOCS OFF CACHE BOOL "" FORCE)
  set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
  set(BUILD_STATIC_LIBS ON CACHE BOOL "" FORCE)
  set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
  set(CURL_BUILD_TESTING OFF CACHE BOOL "" FORCE)
  set(CURL_CLANG_TIDY OFF CACHE BOOL "" FORCE)
  set(CURL_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
  set(CURL_ENABLE_EXPORT_TARGET OFF CACHE BOOL "" FORCE)
  set(CURL_USE_PKGCONFIG OFF CACHE BOOL "" FORCE)
  set(ENABLE_CURL_MANUAL OFF CACHE BOOL "" FORCE)
  set(HTTP_ONLY ON CACHE BOOL "" FORCE)

  set(CURL_ENABLE_SSL ON CACHE BOOL "" FORCE)
  set(CURL_USE_OPENSSL ON CACHE BOOL "" FORCE)
  set(OPENSSL_USE_STATIC_LIBS ON CACHE BOOL "" FORCE)

  if(LLVM_BORINGSSL_SOURCE_DIR)
    get_filename_component(LLVM_BORINGSSL_SOURCE_DIR "${LLVM_BORINGSSL_SOURCE_DIR}" ABSOLUTE)
    include("${CMAKE_CURRENT_LIST_DIR}/LLVMBoringSSL.cmake")
    llvm_configure_boringssl("${LLVM_BORINGSSL_SOURCE_DIR}")

    set(HAVE_AWSLC OFF CACHE BOOL "" FORCE)
    set(HAVE_BORINGSSL ON CACHE BOOL "" FORCE)
    set(HAVE_DES_ECB_ENCRYPT ON CACHE BOOL "" FORCE)
    set(HAVE_LIBRESSL OFF CACHE BOOL "" FORCE)
    set(HAVE_OPENSSL_SRP OFF CACHE BOOL "" FORCE)
    set(HAVE_SSL_SET0_WBIO ON CACHE BOOL "" FORCE)
    set(HAVE_SSL_SET1_ECH_CONFIG_LIST OFF CACHE BOOL "" FORCE)
    set(HAVE_SSL_SET_QUIC_TLS_CBS OFF CACHE BOOL "" FORCE)
    set(HAVE_SSL_SET_QUIC_USE_LEGACY_CODEPOINT ON CACHE BOOL "" FORCE)
  endif()

  set(CURL_BROTLI OFF CACHE BOOL "" FORCE)
  set(CURL_USE_GSASL OFF CACHE BOOL "" FORCE)
  set(CURL_USE_GSSAPI OFF CACHE BOOL "" FORCE)
  set(CURL_USE_LIBPSL OFF CACHE BOOL "" FORCE)
  set(CURL_USE_LIBSSH OFF CACHE BOOL "" FORCE)
  set(CURL_USE_LIBSSH2 OFF CACHE BOOL "" FORCE)
  set(CURL_USE_LIBUV OFF CACHE BOOL "" FORCE)
  set(CURL_USE_MBEDTLS OFF CACHE BOOL "" FORCE)
  set(CURL_USE_RUSTLS OFF CACHE BOOL "" FORCE)
  set(CURL_USE_WOLFSSL OFF CACHE BOOL "" FORCE)
  set(CURL_ZSTD OFF CACHE BOOL "" FORCE)
  set(ENABLE_ARES OFF CACHE BOOL "" FORCE)
  set(USE_LIBIDN2 OFF CACHE BOOL "" FORCE)
  set(USE_NGHTTP2 OFF CACHE BOOL "" FORCE)
  set(USE_OPENSSL_QUIC OFF CACHE BOOL "" FORCE)

  if(NOT TARGET CURL::libcurl)
    add_subdirectory("${LLVM_CURL_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/curl" EXCLUDE_FROM_ALL)
  endif()
  if(NOT TARGET CURL::libcurl)
    message(FATAL_ERROR "LLVM_CURL_SOURCE_DIR did not define target CURL::libcurl: ${LLVM_CURL_SOURCE_DIR}")
  endif()

  set(CURL_FOUND TRUE)
  set(CURL_INCLUDE_DIRS "${LLVM_CURL_SOURCE_DIR}/include" CACHE PATH "" FORCE)
  set(CURL_LIBRARIES CURL::libcurl CACHE STRING "" FORCE)
else()
  include("${CMAKE_ROOT}/Modules/FindCURL.cmake")
endif()

mark_as_advanced(CURL_INCLUDE_DIRS CURL_LIBRARIES)
